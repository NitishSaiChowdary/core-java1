package elements;
import java.util.Scanner;  
public class Task9 {
	    public static void main(String[] args) {
	        Scanner sc = new Scanner(System.in);
	        System.out.println("How many salaries do you want to input?");
	        int count = sc.nextInt();


	        for (int i = 0; i < count; i++) {
	           System.out.println("Enter the salary:");
	            double salary = sc.nextDouble();
	            if (salary == 10000) {
	                System.out.println("Your salary is " +salary);
	            } else if (salary <= 20000) {
	                System.out.println("Your salary is 20000" +salary);
	            } else if (salary <= 30000) {
	                System.out.println("Your salary is 30000" +salary);
	            } else if (salary <= 40000) {
	                System.out.println("Your salary is 40000" +salary);
	            } else if (salary <= 50000) {
	                System.out.println("Your salary is 50000" +salary);
	            } else if (salary <= 60000) {
	                System.out.println("Your salary is 60000" +salary);
	            } else {
	                System.out.println("Your salary is 70000" +salary);
	            }
	        }
	        sc.close();
	    }

}
